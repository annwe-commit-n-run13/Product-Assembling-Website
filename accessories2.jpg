        if ($remove==false)
        {
            // removal of image was not successful
            // set the session message
            $_SESSION['upload'] = "<div class='success-message-delete'>Removing Image File was Unsuccessful</div>";
            // redirect to category page
            header('location:'.SITEURL.'product.php');
            // stop the process
            die();
        }
    }


    // 3. delete product from database 
    // sql query to delete data from database
    $sql = "DELETE FROM table_products WHERE id=$id";

    // to execue the query
    $res = mysqli_query($conn, $sql);

